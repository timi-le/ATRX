# FX AI-Quant Trading System Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# DATA PROVIDER API KEYS
# =============================================================================

# OANDA (Forex Data & Trading)
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice  # practice or live

# Dukascopy (Historical Data)
DUKASCOPY_USERNAME=your_dukascopy_username
DUKASCOPY_PASSWORD=your_dukascopy_password

# Interactive Brokers
IBKR_PORT=7497  # 7497 for TWS, 4001 for IB Gateway
IBKR_CLIENT_ID=1
IBKR_HOST=127.0.0.1

# MetaTrader 5
MT5_LOGIN=210112936
MT5_PASSWORD=Twizb17/0317
MT5_SERVER=Exness-MT5Trial9

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fx_trading
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=trading_password

# =============================================================================
# MESSAGING & COMMUNICATION
# =============================================================================

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ZeroMQ
ZMQ_PUBLISH_PORT=5555
ZMQ_SUBSCRIBE_PORT=5556
ZMQ_BIND_ADDRESS=tcp://*
ZMQ_CONNECT_ADDRESS=tcp://localhost

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================

# Risk Management
MAX_DAILY_DRAWDOWN=0.02  # 2%
MAX_TOTAL_DRAWDOWN=0.10  # 10%
MAX_POSITION_SIZE=0.10   # 10% of account per position
MAX_TOTAL_EXPOSURE=0.80  # 80% total exposure

# Kelly Criterion
KELLY_MULTIPLIER=0.25    # Conservative Kelly fraction

# Position Sizing
DEFAULT_POSITION_SIZE=10000  # USD
ORDER_SLICE_SIZE=10000       # USD for TWAP

# =============================================================================
# SECURITY
